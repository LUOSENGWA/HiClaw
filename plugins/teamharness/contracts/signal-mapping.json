{
  "version": "1.0",
  "description": "Cross-language golden fixture for S2 signal emission (INT-3, #1394 S2 aligned). Single source of truth for the 14-event list: the Go side keeps an in-code emitter table (F8 precedent, task-transitions.json) and cross-checks it against this file in tests; the Python side reads this file at runtime. Precedent: task-transitions.json.",
  "id_rule": "event_id = 'ev_' + sha256(team_id|task_id|event_type|source_event|attempt)[:16] hex (no timestamp: a retry of the same logical event yields the same id; consumers dedupe by event_id, keyed taskId+type+attempt semantics per #1394)",
  "levels": ["info", "warn", "error", "critical"],
  "source_event_note": "source_event = the row's row id, unique per emit point. It is hashed into id_rule, so two emit points must never share it (11-SIGNAL: submit and accept share source_event.origin=submit but use different source_events to keep ids distinct).",
  "events": [
    {
      "source_events": ["task_submitted"],
      "event_type": "SIG-COMPLETE",
      "source_layer": "task",
      "emitters": ["py:submit_task"],
      "level": "info",
      "#1394_type": "task.submitted"
    },
    {
      "source_events": ["task_accepted", "project_completed"],
      "event_type": "SIG-COMPLETE",
      "source_layer": "task",
      "emitters": ["py:accept_task_result", "go:CompleteProject"],
      "level": "info",
      "#1394_type": "task.submitted"
    },
    {
      "source_events": ["project_paused"],
      "event_type": "SIG-DECISION",
      "source_layer": "control",
      "emitters": ["go:PauseProject"],
      "level": "warn",
      "#1394_type": "decision.locked"
    },
    {
      "source_events": ["project_resumed"],
      "event_type": "SIG-DECISION",
      "source_layer": "control",
      "emitters": ["go:ResumeProject"],
      "level": "info",
      "#1394_type": "decision.locked"
    },
    {
      "source_events": ["project_replanned"],
      "event_type": "SIG-DECISION",
      "source_layer": "control",
      "emitters": ["go:ReplanProject"],
      "level": "warn",
      "#1394_type": "decision.locked"
    },
    {
      "source_events": ["task_cancelled"],
      "event_type": "SIG-DECISION",
      "source_layer": "control",
      "emitters": ["go:CancelTask"],
      "level": "error",
      "#1394_type": "decision.locked"
    },
    {
      "source_events": ["loop_iteration_finished"],
      "event_type": "SIG-DECISION",
      "source_layer": "loop",
      "emitters": ["py:record_loop_iteration"],
      "level": "info",
      "#1394_type": "loop.iteration_finished"
    },
    {
      "source_events": ["loop_review_verdict"],
      "event_type": "SIG-VERDICT",
      "source_layer": "loop",
      "emitters": ["py:record_loop_iteration:review"],
      "level": "warn",
      "#1394_type": "loop.iteration_finished"
    },
    {
      "source_events": ["attention_raised"],
      "event_type": "SIG-ATTENTION",
      "source_layer": "attention",
      "emitters": ["#1394:S2"],
      "level": "warn",
      "conditional": true,
      "#1394_type": "attention.raised"
    },
    {
      "source_events": ["attention_resolved"],
      "event_type": "SIG-ATTENTION",
      "source_layer": "attention",
      "emitters": ["#1394:S2"],
      "level": "info",
      "conditional": true,
      "#1394_type": "attention.resolved"
    },
    {
      "source_events": ["attention_overdue"],
      "event_type": "SIG-ATTENTION",
      "source_layer": "attention",
      "emitters": ["#1394:S2"],
      "level": "error",
      "conditional": true,
      "#1394_type": "attention.overdue"
    },
    {
      "source_events": ["mismatch_recorded"],
      "event_type": "SIG-MISMATCH",
      "source_layer": "verification",
      "emitters": ["#future:mismatch_recorded"],
      "level": "error",
      "conditional": true,
      "#1394_type": null
    },
    {
      "source_events": ["contract_snapshot"],
      "event_type": "SIG-CONTRACT",
      "source_layer": "store",
      "emitters": ["#future:contract_snapshot"],
      "level": "warn",
      "conditional": true,
      "#1394_type": null
    },
    {
      "source_events": ["artifact_delivered"],
      "event_type": "SIG-ARTIFACT",
      "source_layer": "store",
      "emitters": ["#future:artifact_write", "#future:handoff_write"],
      "level": "info",
      "conditional": true,
      "#1394_type": null
    }
  ],
  "#1394_types": {
    "task.submitted": ["SIG-COMPLETE"],
    "decision.locked": ["SIG-DECISION"],
    "loop.iteration_finished": ["SIG-DECISION", "SIG-VERDICT"],
    "attention.raised": ["SIG-ATTENTION"],
    "attention.resolved": ["SIG-ATTENTION"],
    "attention.overdue": ["SIG-ATTENTION"]
  }
}
